# Vorlage: kopieren nach .env und Werte anpassen.
# Die Datei .env wird NICHT ins Repository übernommen.

# Passwort der Datenbank (nur Buchstaben und Ziffern verwenden)
POSTGRES_PASSWORD=BitteAendern123

# Gemeinsamer Login für Phase 1
LOGIN_USER=it
# bcrypt-Hash des Passworts, erzeugen mit:
#   docker run --rm caddy:2.10-alpine caddy hash-password --plaintext "MeinPasswort"
# Wichtig: in EINFACHEN Anführungszeichen einfügen (der Hash enthält $-Zeichen).
LOGIN_PASSWORD_HASH='$2a$14$ErsetzenDurchDenErzeugtenHashxxxxxxxxxxxxxxxxxxxxxxxxx'

# Adresse der Anwendung. Zu Hause/Test: localhost. Im Firmennetz z.B. netzdoku.firma.local
SITE_ADDRESS=localhost

# Ports auf dem Rechner (ändern, falls 80/443 schon belegt sind, z.B. 8080/8443)
HTTP_PORT=80
HTTPS_PORT=443
